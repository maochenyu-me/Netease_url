# 复制为 .env 后按需修改（.env 已在 .gitignore 里，不会被提交）
#
# 网易云 cookie：浏览器登录 music.163.com → F12 → Network → 任一请求 → Request Headers → Cookie
# 最少只要 MUSIC_U=...，贴整条风控更宽松。没有黑胶会员也能用，但部分歌只能拿 standard 音质。
MUSIC_COOKIE=

# 服务端口（容器内），改了记得同步改 docker-compose 的 ports 映射
PORT=5000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# CORS 允许来源，默认 *（纯前端直连时保持 * 最省事）
CORS_ORIGINS=*
